#include "main.h"
#include <string.h>

UART_HandleTypeDef huart1;

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_USART1_UART_Init();

    char message[] = "Hello Students!\r\n";

    while(1)
    {
        HAL_UART_Transmit(&huart1,
                          (uint8_t*)message,
                          strlen(message),
                          100);

        HAL_Delay(1000);
    }
}

